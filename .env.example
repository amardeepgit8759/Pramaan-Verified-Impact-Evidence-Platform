# Copy to .env and fill in. Never commit .env.
# The API validates these at startup and exits with a list of anything missing.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# Local: the `db` service from docker-compose.yml (start with `pnpm db:up`).
# Production: your Neon direct connection string, ending in ?sslmode=verify-full
# (Neon shows ?sslmode=require; node-postgres treats that as verify-full but warns).
DATABASE_URL=postgres://pramaan:pramaan@localhost:55432/pramaan
# Integration tests use the `db-test` service; override only if you changed its port.
# TEST_DATABASE_URL=postgres://pramaan:pramaan@localhost:55433/pramaan_test

# --- Auth -----------------------------------------------------------------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a sign-in lasts.
SESSION_TTL_DAYS=7

# --- Cloudinary (Console -> Settings -> API Keys) --------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder that all Pramaan uploads live under.
CLOUDINARY_UPLOAD_FOLDER=pramaan
# Auto-tagging add-on to try first: google_tagging | imagga_tagging | aws_rek_tagging
CLOUDINARY_TAGGING_ADDON=google_tagging
# Tags the add-on is less sure about than this (0-1) are dropped.
CLOUDINARY_AUTO_TAGGING_MIN_CONFIDENCE=0.6

# --- Tagging --------------------------------------------------------------
# cloudinary: use the add-on above, falling back to Gemini if it is not enabled or out of quota.
# gemini: always tag with Gemini vision.
TAGGING_PROVIDER=cloudinary

# --- Google Gemini (https://aistudio.google.com/apikey) --------------------
GEMINI_API_KEY=
# Model ids, from https://ai.google.dev/gemini-api/docs/models (checked 2026-09).
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_REPORT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Twilio WhatsApp (optional; Phase 8 only) ------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Rate limiting (per client IP, all /api routes) ------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Sign-in, sign-up and password-set attempts per IP per window.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Gemini-backed endpoints: per user per minute (search, upload captioning) and
# per organisation per hour (reports).
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=120
REPORT_RATE_LIMIT_WINDOW_MS=3600000
REPORT_RATE_LIMIT_MAX=10

# --- Static web app -------------------------------------------------------
# Set in the Docker image so the API serves the built web app from one origin.
# WEB_DIST_DIR=../web/dist
# Public address, for absolute links in social-preview metadata. On Render this falls
# back to RENDER_EXTERNAL_URL automatically.
# PUBLIC_URL=https://pramaan.example.org
