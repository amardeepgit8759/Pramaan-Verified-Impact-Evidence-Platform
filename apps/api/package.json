{
  "name": "@pramaan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@pramaan/shared": "workspace:*",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "~0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@types/piexifjs": "^1.0.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "~0.31.11",
    "jpeg-js": "^0.4.4",
    "multer": "^2.4.0",
    "piexifjs": "^1.0.6",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
